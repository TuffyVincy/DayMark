rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function habitExists(userId, habitId) {
      return exists(/databases/$(database)/documents/users/$(userId)/habits/$(habitId))
        || existsAfter(/databases/$(database)/documents/users/$(userId)/habits/$(habitId));
    }

    // Pillar 2: Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data, userId) {
      return data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabit(data, userId, habitId) {
      return data.id is string
        && data.id == habitId
        && data.id.size() <= 64
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.category in ['wellness', 'focus', 'fitness', 'learning']
        && data.timeOfDay in ['morning', 'afternoon', 'evening', 'anytime']
        && data.trackingType in ['boolean', 'numeric']
        && data.targetValue is number
        && (
          (data.trackingType == 'boolean' && data.targetValue == 1) ||
          (data.trackingType == 'numeric' && data.targetValue >= 1 && data.targetValue <= 100000)
        )
        && data.unit is string
        && data.unit.size() <= 24
        && data.scheduleDays is list
        && data.scheduleDays.size() >= 1
        && data.scheduleDays.size() <= 7
        && data.scheduleDays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && (!('reminderTime' in data) || (
          data.reminderTime is string
          && data.reminderTime.size() <= 5
          && (data.reminderTime == '' || data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        ))
        && (!('icon' in data) || (
          data.icon is string
          && data.icon in [
            'droplets', 'heart', 'brain', 'dumbbell', 'footprints', 'book',
            'moon', 'sun', 'apple', 'flame', 'music', 'pencil'
          ]
        ))
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabitLog(data, userId, logId) {
      return data.id is string
        && data.id == logId
        && data.id.size() >= 12
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.habitId is string
        && data.habitId.size() >= 1
        && data.habitId.size() <= 64
        && isValidId(data.habitId)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.id == (data.habitId + '_' + data.dateKey)
        && data.value is number
        && data.value >= 0
        && data.value <= 1000000
        && data.targetSnapshot is number
        && data.targetSnapshot >= 1
        && data.targetSnapshot <= 100000
        && data.completed is bool
        && data.updatedAt is timestamp;
    }

    // Users Collection (PII Isolated to Owner Only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow delete: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      // Habits Subcollection
      match /habits/{habitId} {
        allow get: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;

        allow list: if isOwner(userId)
          && existing().userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'title', 'category', 'timeOfDay',
            'trackingType', 'targetValue', 'unit', 'scheduleDays',
            'archived', 'createdAt', 'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'title', 'category', 'icon', 'timeOfDay',
            'trackingType', 'targetValue', 'unit', 'scheduleDays',
            'reminderTime', 'archived', 'createdAt', 'updatedAt'
          ])
          && isValidHabit(incoming(), userId, habitId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);

        allow update: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && isValidHabit(incoming(), userId, habitId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Edit Habit Configuration
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'icon', 'timeOfDay', 'trackingType',
              'targetValue', 'unit', 'scheduleDays', 'reminderTime', 'updatedAt'
            ]) ||
            // Action 2: Archive / Restore Habit
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt'])
          );

        allow delete: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }

      // Daily Habit Logs Subcollection
      match /logs/{logId} {
        allow get: if isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;

        allow list: if isOwner(userId)
          && existing().userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'habitId', 'dateKey',
            'value', 'targetSnapshot', 'completed', 'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'habitId', 'dateKey',
            'value', 'targetSnapshot', 'completed', 'updatedAt'
          ])
          && isValidHabitLog(incoming(), userId, logId)
          && incoming().updatedAt == request.time
          && userExists(userId)
          && habitExists(userId, incoming().habitId);

        allow update: if isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && isValidHabitLog(incoming(), userId, logId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().habitId == existing().habitId
          && incoming().dateKey == existing().dateKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'value', 'targetSnapshot', 'completed', 'updatedAt'
          ])
          && habitExists(userId, incoming().habitId);

        allow delete: if isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }
    }
  }
}
